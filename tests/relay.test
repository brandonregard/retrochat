set root [file dirname [file dirname [info script]]]
source [file join $root lib protocol.tcl]

set port 17777
if {[llength $argv] > 0} { set port [lindex $argv 0] }

set first [socket localhost $port]
set second [socket localhost $port]
fconfigure $first -buffering line -translation lf
fconfigure $second -buffering line -translation lf

set record [retrochat::makeRecord CHAT [list Tester "relay smoke test"]]
puts $first $record
flush $first
set received [gets $second]

close $first
close $second
if {$received != $record} {
    puts stderr "FAIL relay mismatch"
    exit 1
}
puts "relay test passed"
